---
import "@/styles/extra.css";
import "@/styles/privacy.css"
const { frontmatter } = Astro.props;
import PublicNavbar from "@/components/landingPage/PublicNavbar";
import Footer from "@/components/landingPage/Footer";
---

<tshtml>
    <html>
        <head>
            <title>{frontmatter.title}</title>
            <meta
                name="viewport"
                content="width=device-width, initial-scale=1"
            />
            <meta charset="utf-8" />
            <slot name="head" />
        </head>
        <body>
            <PublicNavbar client:load />
            <article class="max-w-3xl mx-auto px-4 py-8 font-serif">
                <header class="mb-8">
                    <h1 class="text-4xl font-bold mb-4">{frontmatter.title}</h1>
                    <time class="text-gray-600">{frontmatter.date}</time>
                </header>

                <div class="max-w-none policy-content">
                    <slot />
                </div>
            </article>
            <Footer />
        </body>
    </html>
</tshtml>
